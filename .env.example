# Secrets de l'environnement Docker local (source unique).
# Lu automatiquement par "docker compose" pour remplir les ${...} de
# docker-compose.yml. Ne jamais versionner le fichier .env.
#
# Mise en place :
#   cp .env.example .env
#   puis remplacer CHAQUE marqueur <...> par une valeur generee avec la
#   commande indiquee. Compose refuse de demarrer si une variable manque.
#
# Les mots de passe des roles ne sont lus qu'au PREMIER demarrage de
# Postgres (volume vide) : les changer ensuite n'a d'effet qu'apres un
# ALTER ROLE manuel ou une reinitialisation du volume.

# Superuser "postgres" : initialisation et administration uniquement.
POSTGRES_PASSWORD=<a-generer: openssl rand -hex 32>

# lfdc_owner : proprietaire de la base, utilise pour les migrations.
DB_OWNER_PASSWORD=<a-generer: openssl rand -hex 32>

# lfdc_app : compte du backend au quotidien (lecture/ecriture des donnees).
DB_APP_PASSWORD=<a-generer: openssl rand -hex 32>

# lfdc_ro : lecture seule (Adminer, psql).
DB_RO_PASSWORD=<a-generer: openssl rand -hex 32>

# Cle de chiffrement AdonisJS (16 caracteres minimum). La perdre ou la
# changer rend illisibles les donnees deja chiffrees.
APP_KEY=<a-generer: openssl rand -hex 16 (32 caracteres)>
