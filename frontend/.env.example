# Uniquement pour lancer Nuxt depuis l'hote, hors Docker (le conteneur
# frontend recoit ses variables de docker-compose.yml). En production, ces
# variables sont definies dans Vercel (Settings > Environment Variables),
# jamais ici.
#
# Toutes sont lues cote serveur seulement (runtimeConfig prive) : le
# navigateur ne voit ni l'URL du backend ni la cle.

# URL du backend jointe par le proxy Nitro (/api/** -> cette URL). Hors
# Docker : backend publie sur l'hote.
NUXT_API_UPSTREAM=http://localhost:3333/api

# Valeur de l'en-tete X-Api-Key ajoute par le proxy, identique a API_KEY du
# backend. Vide si le backend n'a pas d'API_KEY (dev) ; obligatoire en
# production.
NUXT_API_KEY=

# Basic Auth devant tout le frontend. Vides = desactivee (dev local
# uniquement) ; obligatoires en production.
NUXT_BASIC_AUTH_USER=
NUXT_BASIC_AUTH_PASSWORD=
