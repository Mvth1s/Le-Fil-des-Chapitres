# Uniquement pour lancer Nuxt depuis l'hote, hors Docker (le conteneur
# frontend recoit ses variables de docker-compose.yml). Aucun secret ici :
# ces valeurs sont publiques.

# URL de l'API vue par le navigateur.
NUXT_PUBLIC_API_BASE=http://localhost:3333/api

# Utilise uniquement cote serveur (SSR). Sous Docker, c'est le nom du
# service backend sur le reseau interne (http://backend:3333/api) ; hors
# Docker, remplacer par http://localhost:3333/api.
NUXT_API_BASE_SERVER=http://backend:3333/api
