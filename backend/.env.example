# Uniquement pour lancer "node ace" depuis l'hote, hors Docker (le
# conteneur backend recoit ses variables de docker-compose.yml).
#   cp .env.example .env   (dans backend/)
# puis remplacer chaque marqueur par la valeur du .env RACINE : les
# mots de passe doivent etre identiques a ceux des roles crees dans
# Postgres. Postgres doit tourner : "docker compose up postgres".

# Fuseau horaire du process Node, UTC pour des dates coherentes en base.
TZ=UTC
# Port d'ecoute du serveur HTTP AdonisJS.
PORT=3333
# Interface d'ecoute (0.0.0.0 : toutes les interfaces).
HOST=0.0.0.0
# Niveau de log (trace, debug, info, warn, error, fatal).
LOG_LEVEL=info
# Environnement d'execution (development, production, test).
NODE_ENV=development
# Cle de chiffrement AdonisJS, identique a celle du .env racine.
APP_KEY=<a-recopier depuis .env racine: APP_KEY>

# Hote Postgres : localhost car le port 5432 est publie sur 127.0.0.1.
DB_HOST=localhost
# Port Postgres publie par le conteneur.
DB_PORT=5432
# Nom de la base creee par docker/postgres/init/01-roles.sh.
DB_DATABASE=le_fil_des_chapitres

# Compte du quotidien (DML uniquement).
DB_USER=lfdc_app
# Mot de passe de lfdc_app, identique a DB_APP_PASSWORD du .env racine.
DB_PASSWORD=<a-recopier depuis .env racine: DB_APP_PASSWORD>

# Compte des migrations (proprietaire du schema), utilise par
# "node ace migration:run --connection=migration".
DB_MIGRATION_USER=lfdc_owner
# Mot de passe de lfdc_owner, identique a DB_OWNER_PASSWORD du .env racine.
DB_MIGRATION_PASSWORD=<a-recopier depuis .env racine: DB_OWNER_PASSWORD>
